# Copie para .env e preencha todos os valores antes de iniciar o Compose.
# Gere valores próprios. Não use credenciais reais nem reutilize estas entre ambientes.
POSTGRES_USER=
POSTGRES_PASSWORD=
# Gere uma chave aleatória com pelo menos 32 bytes (256 bits).
JWT_SECRET=
LETTERA_ADMIN_EMAIL=admin@admin.dev
LETTERA_ADMIN_PASSWORD=
LETTERA_DEMO_BUYER_PASSWORD=
GRAFANA_PASSWORD=
